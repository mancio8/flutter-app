# Copia questo file in .env e compila i valori.
# Il file .env è ignorato da git e NON va incluso negli asset Flutter.
#
# In produzione/build di release usa --dart-define:
#   flutter build apk --release \
#     --dart-define=SUPABASE_URL=https://<project-ref>.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=<anon-key>
#
# In sviluppo (flutter run) puoi usare flutter_dotenv con questo file.

SUPABASE_URL=
SUPABASE_ANON_KEY=
GOOGLE_BOOKS_API_KEY=